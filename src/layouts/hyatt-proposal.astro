---
/**
 * Hyatt Proposal — full-document ABM proposal page, rendered from a
 * `HyattProposal` CMS item. Ported 1:1 from the static mock
 * `limitless/design/index.html`, with every string, card, and stat lifted into
 * content fields.
 *
 * Class names are all `hy-`-prefixed where they'd otherwise collide with DaisyUI
 * (`hy-hero`, `hy-stats`, `hy-stat`, `hy-btn*`, `hy-card`, `hy-avatar`). The route
 * imports `Base.astro`, which imports `global.css`, so Astro injects the
 * Tailwind+DaisyUI bundle into THIS page too even though the page never asks for
 * it. An unprefixed `.stats` therefore inherited DaisyUI's `display:inline-grid`
 * and the band shrink-wrapped to its content instead of spanning the viewport.
 * Check a new class name before using it:
 *   grep -oE '\.[a-z][a-z0-9-]*[,{: ]' dist/_astro/*.css | sort -u
 *
 * ponytail: the mock's hand-written CSS is kept verbatim in the <style> block
 * below rather than rewritten as Tailwind utilities. It's scoped to this one
 * full-document layout, it's already the design of record, and a port would be
 * churn with a chance of visual drift. (The platform's "native Tailwind, never
 * the Play CDN" rule is about not pulling in a runtime CDN build — plain CSS in
 * a full-document layout is fine.) Rewrite if a second Hyatt layout needs to
 * share these tokens.
 */
import { parseItems, strings, richHtml, sourceDomain, type Source } from './hyatt-lib';
import HyattXray from './hyatt-xray.astro';

interface Props {
  content: any;
  preview?: { cmsUrl?: string; loc?: string; ver?: string; ctx?: string; fallbackNotice?: string | null };
}

// Section ledes are plain `string` fields, but authors put `[^n]` citation
// markers in them, so they render through `richHtml()` (which expands the
// markers) rather than as text. Same trust model as the richText fields.
const { content, preview } = Astro.props;
const c = content ?? {};

const wordmark   = c.wordmark ?? 'HYATT';
// No default photograph on purpose. The old default was `/assets/hero-nyc-skyline.jpg`,
// which put a New York skyline behind an account whose events are in Berlin — and at
// 612x408 it was far too small for a full-bleed `cover` background anyway. Empty now
// falls through to the deep-navy `background-color` in `.hero-bg`.
const heroImage  = c.heroImage || null;
const heroStats  = parseItems<{ count?: number; value?: string; prefix?: string; suffix?: string; label: string }>(c.heroStats);
const trailCards = parseItems<{ date?: string; title?: string; where?: string; body?: string; terms?: string[] }>(c.trailCards);
const marquee    = strings(c.marqueeItems);
const teamCards  = parseItems<{ team?: string; scope?: string; owns?: string[]; gain?: string; person?: string; personTitle?: string }>(c.teamCards);
const pillars    = parseItems<{ num?: string; title?: string; body?: string; image?: string; alt?: string; items?: string[] }>(c.offerPillars);
const results    = parseItems<{ value?: string; label?: string }>(c.expResults);
const cities     = parseItems<{ city?: string; pin?: string; cards?: { name?: string; dist?: string; body?: string; image?: string; alt?: string }[] }>(c.stayCities);
const careItems  = parseItems<{ title?: string; body?: string }>(c.careItems);
const footerCols = parseItems<{ title?: string; links?: { label?: string; url?: string }[] }>(c.footerCols);

// Sources are numbered in order unless the author pinned an `n`, so inline
// `[^n]` markers and the list below always agree.
const sources: Source[] = parseItems<Source>(c.sources).map((s, i) => ({ ...s, n: s.n ?? i + 1 }));

const controlItems    = strings(c.controlItems);
const challengerItems = strings(c.challengerItems);
const planOptions     = strings(c.planOptions);

const title       = c.metaTitle ?? c._metadata?.displayName ?? `Hyatt × ${c.accountName ?? 'your team'}`;
const description = c.metaDescription ?? '';

// Anchor targets are stable ids; nav labels come from the section eyebrows so an
// editor renaming a section renames its nav link too.
const navSections = [
  // #team is deliberately NOT in the nav: six links plus the CTA wrap onto three
  // lines at 1440px and collide with the "prepared exclusively for" block. The
  // section sits directly under the calendar, which is where it reads anyway.
  { id: 'trail',      label: c.trailEyebrow },
  { id: 'offer',      label: c.offerEyebrow },
  { id: 'experiment', label: c.expEyebrow },
  { id: 'stay',       label: c.stayEyebrow },
  { id: 'care',       label: c.careEyebrow },
].filter((s) => !!s.label);
---

<!doctype html>
<html lang={preview?.loc || 'en'}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
{preview?.cmsUrl && <script is:inline src={`${preview.cmsUrl}/util/javascript/communicationinjector.js`}></script>}
<style define:vars={{ heroImage: heroImage ? `url('${heroImage}')` : 'none' }}>
  :root{
    --navy:#0e2240;
    --navy-deep:#091a32;
    --navy-soft:#162c4f;
    --gold:#c2a060;
    --gold-light:#dcc08a;
    --cream:#f7f3ec;
    --cream-2:#efe8da;
    --ink:#1d2b45;
    --slate:#4a5a77;
    --white:#ffffff;
    --serif:'Cormorant Garamond',Georgia,serif;
    --sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:var(--sans);color:var(--ink);background:var(--cream);line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  img{display:block;max-width:100%}
  a{text-decoration:none;color:inherit}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px}

  /* ---------- reveal on scroll ---------- */
  .reveal{opacity:0;transform:translateY(34px);transition:opacity .9s cubic-bezier(.22,.61,.36,1),transform .9s cubic-bezier(.22,.61,.36,1)}
  .reveal.in{opacity:1;transform:none}
  .reveal[data-delay="1"]{transition-delay:.12s}
  .reveal[data-delay="2"]{transition-delay:.24s}
  .reveal[data-delay="3"]{transition-delay:.36s}
  @media(prefers-reduced-motion:reduce){
    .reveal{opacity:1;transform:none;transition:none}
    .hero-bg{animation:none}
    .marquee .track{animation:none}
  }

  /* ---------- eyebrow / headings ---------- */
  .eyebrow{font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:14px}
  .eyebrow::before{content:"";width:38px;height:1px;background:var(--gold)}
  .eyebrow.center{justify-content:center}
  .eyebrow.center::after{content:"";width:38px;height:1px;background:var(--gold)}
  h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.12;color:var(--navy)}
  .h-xl{font-size:clamp(44px,6.4vw,84px)}
  .h-lg{font-size:clamp(34px,4.4vw,56px)}
  em.g{font-style:italic;color:var(--gold)}

  /* ---------- inline citations ---------- */
  .hy-cite{font-size:10px;font-weight:600;margin-left:2px}
  .hy-cite a{color:var(--gold);opacity:.85}
  .hy-cite a:hover{opacity:1;text-decoration:underline}

  /* ---------- nav ---------- */
  nav{position:fixed;top:0;left:0;right:0;z-index:100;transition:background .4s ease,box-shadow .4s ease,padding .4s ease}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;padding-top:20px;padding-bottom:20px}
  nav.scrolled{background:rgba(9,26,50,.92);backdrop-filter:blur(14px);box-shadow:0 8px 30px rgba(0,0,0,.25)}
  nav.scrolled .wrap{padding-top:12px;padding-bottom:12px}
  .brand{display:flex;align-items:center;gap:14px}
  .brand .mark{font-family:var(--serif);font-weight:700;font-size:26px;letter-spacing:.34em;color:var(--white)}
  .brand .mark span{color:var(--gold)}
  .brand .for{border-left:1px solid rgba(255,255,255,.28);padding-left:14px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.72);line-height:1.5}
  .brand .for b{display:block;color:var(--gold-light);font-weight:600}
  .navlinks{display:flex;gap:34px;align-items:center}
  .navlinks a{font-size:12.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.82);position:relative;padding:6px 0}
  .navlinks a::after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--gold);transition:width .35s ease}
  .navlinks a:hover{color:var(--white)}
  .navlinks a:hover::after{width:100%}
  .navcta{background:var(--gold);color:var(--navy-deep)!important;padding:11px 22px!important;border-radius:2px;font-weight:600!important;transition:background .3s ease,transform .3s ease}
  .navcta::after{display:none}
  .navcta:hover{background:var(--gold-light);transform:translateY(-1px)}
  .burger{display:none;background:none;border:none;cursor:pointer;flex-direction:column;gap:5px;padding:8px}
  .burger span{width:24px;height:2px;background:var(--white);transition:.3s}
  @media(max-width:960px){
    .navlinks{position:fixed;inset:0;background:var(--navy-deep);flex-direction:column;justify-content:center;gap:28px;opacity:0;pointer-events:none;transition:opacity .35s ease}
    .navlinks.open{opacity:1;pointer-events:auto}
    .navlinks a{font-size:16px}
    .burger{display:flex;z-index:110}
    .burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .burger.open span:nth-child(2){opacity:0}
    .burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  }

  /* ---------- hero ---------- */
  header.hy-hero{position:relative;min-height:100vh;display:flex;align-items:flex-end;color:var(--white);overflow:hidden;background:var(--navy-deep)}
  /* CMS preview renders this page in an auto-resizing iframe: the host measures
     content height and grows the frame to match. A `100vh` hero then measures
     against the *new* height, grows, and the frame grows again — an endless
     scrollbar. Inside preview only, pin the hero to a fixed height so the
     measurement can settle. `svh`/`dvh` don't help; the loop is the resize
     observer, not the URL-bar heuristic those units address. */
  body[data-preview] header.hy-hero{min-height:680px}

  /* background-color under the image, so a missing or slow hero shows deep navy
     rather than white — and an account with no suitable city photograph degrades
     to a clean brand-coloured hero instead of the wrong city's skyline. */
  .hero-bg{position:absolute;inset:0;background-color:var(--navy-deep);background-image:var(--heroImage);background-position:center;background-size:cover;background-repeat:no-repeat;transform:scale(1.08);animation:heroZoom 18s ease-out forwards}
  @keyframes heroZoom{to{transform:scale(1)}}
  /* Two scrims, not one flat wash. The copy is left-aligned, so the horizontal
     layer carries most of the darkening on the left and releases the right side —
     the skyline stays legible as a photograph instead of being greyed out. The
     vertical layer keeps the nav readable at the top and lands the section into
     the next band at the bottom.
     The old single 180deg wash (.62/.42/.9) already PASSED WCAG on backdrop
     luminance — headline 7.94:1, eyebrow 3.54:1 worst-decile. The problem was
     never the ratio: it was high-frequency detail (lit office windows) sitting
     directly behind 64px serif type, which reads as mush at any ratio. These
     stops roughly double the margin (headline 14.75:1, eyebrow 7.03:1) and, more
     to the point, flatten that busy detail where the copy sits.
     Measure the BACKDROP, not the composite — sampling a screenshot that still
     shows white glyphs counts the text as its own background and reports
     nonsense. Hide `.hy-hero .wrap` first, then sample. */
  .hero-veil{position:absolute;inset:0;background:
    linear-gradient(100deg,rgba(9,26,50,.88) 0%,rgba(9,26,50,.80) 32%,rgba(9,26,50,.46) 62%,rgba(9,26,50,.30) 100%),
    linear-gradient(180deg,rgba(9,26,50,.58) 0%,rgba(9,26,50,.34) 42%,rgba(9,26,50,.92) 100%)}
  /* Releasing the right-hand side only works when there is spare width beside the
     copy. Narrow screens have none — the headline runs almost edge to edge — so
     drop the horizontal layer and wash evenly instead. */
  @media(max-width:920px){
    .hero-veil{background:linear-gradient(180deg,rgba(9,26,50,.74) 0%,rgba(9,26,50,.64) 42%,rgba(9,26,50,.94) 100%)}
  }
  .hy-hero .wrap{position:relative;z-index:2;width:100%;padding-bottom:110px;padding-top:180px}
  .hy-hero .eyebrow{color:var(--gold-light)}
  .hy-hero h1{color:var(--white);max-width:15ch;margin:26px 0 24px}
  .hy-hero p.lede{max-width:600px;font-size:clamp(16px,1.6vw,19px);font-weight:300;color:rgba(255,255,255,.88)}
  .hy-hero p.lede b{font-weight:600;color:var(--gold-light)}
  .hero-ctas{display:flex;gap:18px;margin-top:38px;flex-wrap:wrap}
  .hy-btn{display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:16px 32px;border-radius:2px;transition:all .3s ease;cursor:pointer;border:none}
  .hy-btn-gold{background:var(--gold);color:var(--navy-deep)}
  .hy-btn-gold:hover{background:var(--gold-light);transform:translateY(-2px);box-shadow:0 12px 28px rgba(194,160,96,.32)}
  .hy-btn-ghost{background:transparent;color:var(--white);border:1px solid rgba(255,255,255,.5)}
  .hy-btn-ghost:hover{border-color:var(--gold);color:var(--gold-light);transform:translateY(-2px)}
  .hy-btn-navy{background:var(--navy);color:var(--white)}
  .hy-btn-navy:hover{background:var(--navy-soft);transform:translateY(-2px);box-shadow:0 12px 28px rgba(14,34,64,.3)}
  .hero-tag{position:absolute;right:40px;bottom:40px;z-index:2;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.55);writing-mode:vertical-rl}
  @media(max-width:720px){.hero-tag{display:none}}

  /* ---------- stats band ---------- */
  .hy-stats{background:var(--navy-deep);color:var(--white);border-top:1px solid rgba(194,160,96,.35)}
  .hy-stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding-top:52px;padding-bottom:52px}
  .hy-stat{text-align:center;padding:8px 12px}
  .hy-stat+.hy-stat{border-left:1px solid rgba(255,255,255,.12)}
  .hy-stat .num{font-family:var(--serif);font-size:clamp(34px,3.6vw,50px);font-weight:600;color:var(--gold-light)}
  .hy-stat .lbl{font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.66);margin-top:6px}
  @media(max-width:760px){.hy-stats .wrap{grid-template-columns:repeat(2,1fr)}.hy-stat+.hy-stat{border-left:none}}

  /* ---------- generic section ---------- */
  section{padding:110px 0}
  .sec-head{max-width:720px;margin-bottom:64px}
  .sec-head.center{margin-left:auto;margin-right:auto;text-align:center}
  .sec-head h2{margin-top:18px}
  .sec-head p{margin-top:20px;color:var(--slate);font-size:16.5px}
  .sec-head.center p{margin-left:auto;margin-right:auto;max-width:620px}

  /* ---------- trail map (the account's events) ---------- */
  #trail{background:var(--cream)}
  .trail-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}
  @media(max-width:880px){.trail-grid{grid-template-columns:1fr}}
  .trail-card{background:var(--white);border:1px solid #e7dfd0;border-radius:4px;padding:38px 36px;position:relative;overflow:hidden;transition:transform .35s ease,box-shadow .35s ease,border-color .35s ease}
  .trail-card:hover{transform:translateY(-6px);box-shadow:0 22px 48px rgba(14,34,64,.12);border-color:var(--gold)}
  .trail-card::before{content:"";position:absolute;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,var(--gold),transparent)}
  .trail-date{display:inline-block;font-size:11.5px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);background:rgba(194,160,96,.12);padding:7px 14px;border-radius:2px;margin-bottom:20px}
  .trail-card h3{font-size:27px;margin-bottom:6px}
  .trail-card .where{font-size:13px;font-weight:600;letter-spacing:.06em;color:var(--slate);margin-bottom:14px}
  .trail-card p{font-size:14.5px;color:var(--slate)}
  .trail-card .camp-terms{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
  .trail-card .camp-terms span{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--navy);border:1px solid var(--cream-2);background:var(--cream);padding:5px 12px;border-radius:20px}

  /* ---------- who runs this ---------- */
  /* auto-fit, not a fixed 3 columns: card count varies by account (2–5 teams),
     so the grid reflows on its own instead of needing a breakpoint per count. */
  #team{background:var(--white)}
  .team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px}
  .team-card{background:var(--cream);border:1px solid #e7dfd0;border-radius:4px;padding:32px 30px;display:flex;flex-direction:column;transition:transform .35s ease,box-shadow .35s ease,border-color .35s ease}
  .team-card:hover{transform:translateY(-6px);box-shadow:0 22px 48px rgba(14,34,64,.1);border-color:var(--gold)}
  .team-card h3{font-size:24px;margin-bottom:6px}
  .team-card .scope{font-size:13px;font-weight:600;letter-spacing:.04em;color:var(--gold);text-transform:uppercase;margin-bottom:16px}
  .team-card ul{list-style:none;margin:0}
  .team-card li{font-size:14px;color:var(--slate);padding:7px 0 7px 22px;position:relative}
  .team-card li::before{content:"·";position:absolute;left:6px;top:5px;color:var(--gold);font-size:20px;line-height:1}
  /* margin-top:auto bottom-anchors the payoff band so the rules line up across
     the row even when the teams own different numbers of things. */
  .team-card .gain{margin-top:auto;padding-top:18px;border-top:1px solid #e2d9c8}
  .team-card .gain span{display:block;font-size:10.5px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--navy);margin-bottom:6px}
  .team-card .gain p{font-size:14px;color:var(--slate)}
  .team-card .who{padding-top:20px;display:flex;align-items:center;gap:14px}
  .team-card .who .hy-avatar{width:42px;height:42px;flex:none;border-radius:50%;background:var(--navy);color:var(--gold-light);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:17px;font-weight:600}
  .team-card .who b{display:block;font-size:14px;color:var(--navy)}
  .team-card .who span{display:block;font-size:12.5px;color:var(--slate)}
  .team-note{margin-top:26px;font-size:12.5px;font-style:italic;color:var(--slate)}

  /* ---------- offer pillars ---------- */
  #offer{background:var(--navy);color:var(--white);position:relative;overflow:hidden}
  #offer::before{content:"";position:absolute;top:-180px;right:-180px;width:520px;height:520px;border:1px solid rgba(194,160,96,.16);border-radius:50%}
  #offer::after{content:"";position:absolute;bottom:-260px;left:-140px;width:460px;height:460px;border:1px solid rgba(194,160,96,.12);border-radius:50%}
  #offer .sec-head h2{color:var(--white)}
  #offer .sec-head p{color:rgba(255,255,255,.75)}
  .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;position:relative;z-index:2}
  @media(max-width:980px){.pillars{grid-template-columns:1fr}}
  .pillar{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.12);border-radius:4px;overflow:hidden;transition:transform .35s ease,border-color .35s ease,background .35s ease}
  .pillar:hover{transform:translateY(-6px);border-color:rgba(194,160,96,.55);background:rgba(255,255,255,.07)}
  .pillar img{height:210px;width:100%;object-fit:cover}
  .pillar .body{padding:30px 28px 34px}
  .pillar .num{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--gold)}
  .pillar h3{color:var(--white);font-size:25px;margin:8px 0 12px}
  .pillar p{font-size:14px;color:rgba(255,255,255,.72)}
  .pillar ul{list-style:none;margin-top:18px}
  .pillar li{font-size:13.5px;color:rgba(255,255,255,.85);padding:7px 0 7px 26px;position:relative;border-bottom:1px solid rgba(255,255,255,.08)}
  .pillar li:last-child{border-bottom:none}
  .pillar li::before{content:"✦";position:absolute;left:2px;color:var(--gold);font-size:11px}

  /* ---------- experiment ---------- */
  #experiment{background:var(--cream-2)}
  .ab-wrap{display:grid;grid-template-columns:1fr auto 1fr;gap:26px;align-items:stretch;margin-top:10px}
  @media(max-width:920px){.ab-wrap{grid-template-columns:1fr}.ab-vs{transform:rotate(0);margin:6px auto}}
  .ab-card{background:var(--white);border-radius:4px;padding:36px;border:1px solid #e2d9c8}
  .ab-card.winner{border:2px solid var(--gold);box-shadow:0 24px 54px rgba(14,34,64,.14);position:relative}
  .ab-card .tag{font-size:11px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;padding:6px 14px;border-radius:2px;display:inline-block;margin-bottom:20px}
  .ab-card .tag.a{background:#e9e3d6;color:var(--slate)}
  .ab-card .tag.b{background:var(--navy);color:var(--gold-light)}
  .ab-card h3{font-size:26px;margin-bottom:16px}
  .ab-card ul{list-style:none}
  .ab-card li{font-size:14.5px;color:var(--slate);padding:8px 0 8px 28px;position:relative}
  .ab-card li::before{position:absolute;left:0;top:9px;font-size:13px}
  .ab-card.bad li::before{content:"✕";color:#b0524a}
  .ab-card.good li::before{content:"✓";color:#4a7d5c;font-weight:700}
  .ab-vs{align-self:center;font-family:var(--serif);font-style:italic;font-size:22px;color:var(--slate);transform:rotate(-90deg)}
  .ab-results{margin-top:34px;background:var(--navy-deep);border-radius:4px;padding:34px 38px;display:flex;gap:36px;flex-wrap:wrap;justify-content:space-between;align-items:center}
  .ab-results .r{text-align:center;flex:1;min-width:150px}
  .ab-results .r .v{font-family:var(--serif);font-size:clamp(28px,3vw,40px);color:var(--gold-light);font-weight:600}
  .ab-results .r .k{font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.62);margin-top:4px}
  .ab-footnote{margin-top:16px;font-size:12.5px;font-style:italic;color:var(--slate);text-align:center}

  /* ---------- stays ---------- */
  #stay{background:var(--cream)}
  .city-label{display:flex;align-items:center;gap:18px;margin:54px 0 26px}
  .city-label h3{font-size:30px}
  .city-label .line{flex:1;height:1px;background:#ddd3bf}
  .city-label .pin{font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)}
  .stay-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  @media(max-width:980px){.stay-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:680px){.stay-grid{grid-template-columns:1fr}}
  .stay-card{background:var(--white);border-radius:4px;overflow:hidden;border:1px solid #e7dfd0;transition:transform .35s ease,box-shadow .35s ease}
  .stay-card:hover{transform:translateY(-6px);box-shadow:0 22px 48px rgba(14,34,64,.13)}
  .stay-card .ph{height:210px;overflow:hidden}
  .stay-card .ph img{width:100%;height:100%;object-fit:cover;transition:transform .8s ease}
  .stay-card:hover .ph img{transform:scale(1.06)}
  .stay-card .body{padding:24px 26px 28px}
  .stay-card h4{font-family:var(--serif);font-size:22px;color:var(--navy);font-weight:600}
  .stay-card .dist{display:inline-block;margin-top:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(194,160,96,.4);padding:4px 11px;border-radius:20px}
  .stay-card p{font-size:13.5px;color:var(--slate);margin-top:12px}

  /* ---------- care band ---------- */
  #care{background:var(--navy-deep);color:var(--white);position:relative;overflow:hidden}
  .care-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:70px;align-items:center}
  @media(max-width:920px){.care-grid{grid-template-columns:1fr;gap:44px}}
  #care h2{color:var(--white)}
  #care .lead{color:rgba(255,255,255,.78);margin-top:22px;font-size:16.5px;font-weight:300}
  .care-list{margin-top:34px;list-style:none}
  .care-list li{padding:16px 0;border-bottom:1px solid rgba(255,255,255,.1);display:flex;gap:18px;align-items:flex-start}
  .care-list li:last-child{border-bottom:none}
  .care-list .dot{width:34px;height:34px;flex:none;border:1px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:13px}
  .care-list b{display:block;color:var(--white);font-size:15px;font-weight:600}
  .care-list span{font-size:13.5px;color:rgba(255,255,255,.66)}
  .care-img{position:relative}
  .care-img img{border-radius:4px;width:100%;height:520px;object-fit:cover}
  .care-img::after{content:"";position:absolute;inset:-18px 18px 18px -18px;border:1px solid var(--gold);border-radius:4px;z-index:-1}
  @media(max-width:920px){.care-img img{height:380px}}

  /* ---------- quote strip ---------- */
  .strip{background:var(--gold);color:var(--navy-deep);text-align:center;padding:76px 0}
  .strip blockquote{font-family:var(--serif);font-size:clamp(26px,3.4vw,40px);font-weight:600;font-style:italic;max-width:20ch;margin:0 auto;line-height:1.25}
  .strip cite{display:block;margin-top:20px;font-family:var(--sans);font-style:normal;font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase}

  /* ---------- contact ---------- */
  #contact{background:var(--cream)}
  .contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:70px;align-items:start}
  @media(max-width:920px){.contact-grid{grid-template-columns:1fr;gap:48px}}
  .contact-copy p{margin-top:20px;color:var(--slate);font-size:16px}
  .contact-copy .sig{margin-top:36px;display:flex;align-items:center;gap:18px}
  .contact-copy .sig .hy-avatar{width:56px;height:56px;border-radius:50%;background:var(--navy);color:var(--gold-light);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:22px;font-weight:600}
  .contact-copy .sig b{display:block;font-size:15px}
  .contact-copy .sig span{font-size:13px;color:var(--slate)}
  form.hy-card{background:var(--white);border:1px solid #e7dfd0;border-radius:4px;padding:42px;box-shadow:0 22px 54px rgba(14,34,64,.08);position:relative;overflow:hidden}
  form.hy-card::before{content:"";position:absolute;top:0;left:0;width:100%;height:4px;background:linear-gradient(90deg,var(--navy),var(--gold))}
  .fld{margin-bottom:20px}
  .fld label{display:block;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--navy);margin-bottom:8px}
  .fld input,.fld select,.fld textarea{width:100%;padding:14px 16px;border:1px solid #ddd3bf;border-radius:2px;font-family:var(--sans);font-size:14.5px;color:var(--ink);background:var(--cream);transition:border-color .3s ease,box-shadow .3s ease}
  .fld input:focus,.fld select:focus,.fld textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(194,160,96,.16);background:var(--white)}
  .fld-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  @media(max-width:560px){.fld-row{grid-template-columns:1fr}}
  .form-note{font-size:12px;color:var(--slate);margin-top:14px;text-align:center}
  .success{display:none;text-align:center;padding:50px 10px}
  .success.show{display:block;animation:pop .5s ease}
  @keyframes pop{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
  .success .tick{width:72px;height:72px;margin:0 auto 22px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;color:var(--gold-light);font-size:30px}
  .success h3{font-size:28px;margin-bottom:10px}
  .success p{color:var(--slate);font-size:14.5px;max-width:40ch;margin:0 auto}

  /* ---------- sources ---------- */
  #sources{background:var(--cream-2);padding:82px 0}
  #sources .sec-head{margin-bottom:38px}
  .src-group{margin-top:30px}
  .src-group>b{display:block;font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:14px}
  .src-list{list-style:none}
  .src-list li{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #ddd3bf;font-size:13.5px;color:var(--slate)}
  .src-list li:last-child{border-bottom:none}
  .src-list .n{font-family:var(--serif);font-size:15px;color:var(--navy);flex:none;min-width:22px}
  .src-list a{color:var(--navy);border-bottom:1px solid rgba(194,160,96,.55)}
  .src-list a:hover{color:var(--gold)}
  .src-list .meta{display:block;font-size:12px;color:#8b93a3;margin-top:2px}

  /* ---------- footer ---------- */
  footer{background:var(--navy-deep);color:rgba(255,255,255,.6);padding:64px 0 40px;font-size:13px}
  footer .top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;padding-bottom:38px;border-bottom:1px solid rgba(255,255,255,.12)}
  footer .fmark{font-family:var(--serif);font-weight:700;font-size:24px;letter-spacing:.32em;color:var(--white)}
  footer .fmark span{color:var(--gold)}
  footer .cols{display:flex;gap:70px;flex-wrap:wrap}
  footer .col b{display:block;color:var(--white);font-size:12px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:14px}
  footer .col a{display:block;color:rgba(255,255,255,.6);font-size:13px;padding:4px 0;transition:color .3s}
  footer .col a:hover{color:var(--gold-light)}
  footer .legal{margin-top:34px;font-size:11.5px;line-height:1.7;color:rgba(255,255,255,.42);max-width:900px}

  .marquee{overflow:hidden;background:var(--navy);border-top:1px solid rgba(194,160,96,.3);border-bottom:1px solid rgba(194,160,96,.3);padding:18px 0}
  .marquee .track{display:flex;gap:56px;white-space:nowrap;animation:scroll 30s linear infinite;width:max-content}
  .marquee span{font-family:var(--serif);font-style:italic;font-size:17px;color:var(--gold-light);display:flex;align-items:center;gap:56px}
  .marquee span::after{content:"✦";font-style:normal;font-size:11px}
  @keyframes scroll{to{transform:translateX(-50%)}}

  /* ---------- CMS preview banner ---------- */
  .pv{background:#fdf6e3;border-bottom:1px solid #e6d9a8;color:#7a5c12;font-size:12.5px;padding:8px 0;position:relative;z-index:120}
  .pv .wrap{display:flex;gap:14px;flex-wrap:wrap}
</style>
</head>
<body data-preview={preview ? '' : undefined}>

{preview && (
  <div class="pv">
    <div class="wrap">
      <span><b>Preview</b> · locale {preview.loc || 'default'} · version {preview.ver} · context {preview.ctx}</span>
      {preview.fallbackNotice && <span>ℹ️ {preview.fallbackNotice}</span>}
    </div>
  </div>
)}

<nav id="nav" data-xray="Account header &amp; nav" data-xt="hyatt_proposal_planner|hyatt_proposal_builder|cms_update_content_item" data-xd="CMS: accountName, preparedFor, wordmark, navCtaLabel|Nav labels are the section eyebrow fields — one edit renames both|Account name parsed from the chat request by the planner">
  <div class="wrap">
    <div class="brand">
      <div class="mark">{wordmark}<span>✦</span></div>
      {c.accountName && (
        <div class="for">{c.preparedFor ?? 'Prepared exclusively for'}<b>{c.accountName}</b></div>
      )}
    </div>
    <div class="navlinks" id="navlinks">
      {navSections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      <a href="#contact" class="navcta">{c.navCtaLabel ?? 'Start the Conversation'}</a>
    </div>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="navlinks"><span></span><span></span><span></span></button>
  </div>
</nav>

<header class="hy-hero" id="basecamp" data-xray="Hero" data-xt="hyatt_proposal_planner|search_web|browse_web|get_canvas|cms_publish_content_item" data-xd="CMS: eyebrow, heroHeadlineHtml, heroLedeHtml, heroPrimaryCta, heroSecondaryCta, heroImage, heroImageCaption|Account research (sources group "account") for the event, dates and city|hyatt-vendor-facts skill for the Hyatt-side promise in the lede">
  <div class="hero-bg"></div>
  <div class="hero-veil"></div>
  <div class="wrap">
    {c.eyebrow && <div class="eyebrow reveal">{c.eyebrow}</div>}
    <h1 class="h-xl reveal" data-delay="1" set:html={richHtml(c.heroHeadlineHtml)} />
    <p class="lede reveal" data-delay="2" set:html={richHtml(c.heroLedeHtml)} />
    <div class="hero-ctas reveal" data-delay="3">
      {c.heroPrimaryCta && <a href="#contact" class="hy-btn hy-btn-gold">{c.heroPrimaryCta}</a>}
      {c.heroSecondaryCta && <a href="#trail" class="hy-btn hy-btn-ghost">{c.heroSecondaryCta}</a>}
    </div>
  </div>
  {c.heroImageCaption && <div class="hero-tag">{c.heroImageCaption}</div>}
</header>

{heroStats.length > 0 && (
  <div class="hy-stats" data-xray="Stat band" data-xt="search_web|figure_out_search_keywords|hyatt-vendor-facts" data-xd="CMS: heroStats[] ({count,value,prefix,suffix,label} JSON strings)|Property / brand / country counts from the hyatt-vendor-facts skill (sources group "hyatt")|Attendee and room-night figures from account research (group "account")">
    <div class="wrap">
      {heroStats.map((s, i) => (
        <div class="hy-stat reveal" data-delay={i % 4 || undefined}>
          <div
            class="num"
            data-count={s.count ?? undefined}
            data-prefix={s.prefix ?? undefined}
            data-suffix={s.suffix ?? undefined}
          >{s.count != null ? '0' : (s.value ?? '')}</div>
          <div class="lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
)}

{trailCards.length > 0 && (
  <section id="trail" data-xray="Event trail" data-xt="hyatt_proposal_planner|figure_out_search_keywords|search_web|browse_web" data-xd="CMS: trailEyebrow, trailHeadingHtml, trailLede, trailCards[] ({date,title,where,body,terms})|Entirely account research — the prospect’s own event calendar and venues (group "account")|Inline [^n] markers link each claim to its source row">
    <div class="wrap">
      <div class="sec-head reveal">
        {c.trailEyebrow && <div class="eyebrow">{c.trailEyebrow}</div>}
        <h2 class="h-lg" set:html={richHtml(c.trailHeadingHtml)} />
        {c.trailLede && <p set:html={richHtml(c.trailLede)} />}
      </div>
      <div class="trail-grid">
        {trailCards.map((t, i) => (
          <div class="trail-card reveal" data-delay={i % 4 || undefined}>
            {t.date && <span class="trail-date">{t.date}</span>}
            <h3>{t.title}</h3>
            {t.where && <div class="where">{t.where}</div>}
            {t.body && <p set:html={richHtml(t.body)} />}
            {t.terms && t.terms.length > 0 && (
              <div class="camp-terms">{t.terms.map((x) => <span>{x}</span>)}</div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{teamCards.length > 0 && (
  <section id="team" data-xray="Who runs this at the account" data-xt="hyatt_proposal_planner|search_web|browse_web|hyatt_proposal_builder" data-xd="CMS: teamEyebrow, teamHeadingHtml, teamLede, teamCards[] ({team,scope,owns,gain,person,personTitle}), teamNote|Account research only — the prospect’s own event, travel and procurement owners (group &quot;account&quot;)|A named individual appears ONLY when a public current source says so and is cited; otherwise the card names the team alone">
    <div class="wrap">
      <div class="sec-head reveal">
        {c.teamEyebrow && <div class="eyebrow">{c.teamEyebrow}</div>}
        <h2 class="h-lg" set:html={richHtml(c.teamHeadingHtml)} />
        {c.teamLede && <p set:html={richHtml(c.teamLede)} />}
      </div>
      <div class="team-grid">
        {teamCards.map((t, i) => (
          <div class="team-card reveal" data-delay={i % 3 || undefined}>
            <h3>{t.team}</h3>
            {t.scope && <div class="scope" set:html={richHtml(t.scope)} />}
            {t.owns && t.owns.length > 0 && <ul>{t.owns.map((x) => <li set:html={richHtml(x)} />)}</ul>}
            {t.gain && (
              <div class="gain">
                <span>What changes for them</span>
                <p set:html={richHtml(t.gain)} />
              </div>
            )}
            {t.person && (
              <div class="who">
                <div class="hy-avatar" aria-hidden="true">{t.person.trim().charAt(0)}</div>
                <div><b>{t.person}</b>{t.personTitle && <span>{t.personTitle}</span>}</div>
              </div>
            )}
          </div>
        ))}
      </div>
      {c.teamNote && <p class="team-note" set:html={richHtml(c.teamNote)} />}
    </div>
  </section>
)}

{marquee.length > 0 && (
  <div class="marquee" aria-hidden="true" data-xray="Brand marquee" data-xt="hyatt-vendor-facts|hyatt_proposal_builder" data-xd="CMS: marqueeItems[] (plain strings)|Approved Hyatt brand names and programme phrases from the vendor-facts skill (group "hyatt")">
    <div class="track">
      {/* rendered twice — the -50% keyframe scrolls one full copy */}
      {marquee.map((m) => <span>{m}</span>)}
      {marquee.map((m) => <span>{m}</span>)}
    </div>
  </div>
)}

{pillars.length > 0 && (
  <section id="offer" data-xray="Offer pillars" data-xt="hyatt-vendor-facts|get_canvas|hyatt_proposal_builder" data-xd="CMS: offerEyebrow, offerHeadingHtml, offerLede, offerPillars[] ({num,title,body,image,alt,items})|Every Hyatt capability claim comes from the hyatt-vendor-facts skill (group "hyatt"), never re-researched per account|Pillar images are plain paths served from public/assets/">
    <div class="wrap">
      <div class="sec-head reveal">
        {c.offerEyebrow && <div class="eyebrow">{c.offerEyebrow}</div>}
        <h2 class="h-lg" set:html={richHtml(c.offerHeadingHtml)} />
        {c.offerLede && <p set:html={richHtml(c.offerLede)} />}
      </div>
      <div class="pillars">
        {pillars.map((p, i) => (
          <div class="pillar reveal" data-delay={i % 4 || undefined}>
            {p.image && <img src={p.image} alt={p.alt ?? ''} loading="lazy" />}
            <div class="body">
              {p.num && <div class="num">{p.num}</div>}
              <h3>{p.title}</h3>
              {p.body && <p set:html={richHtml(p.body)} />}
              {p.items && p.items.length > 0 && <ul>{p.items.map((x) => <li set:html={richHtml(x)} />)}</ul>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{(controlItems.length > 0 || challengerItems.length > 0) && (
  <section id="experiment" data-xray="A/B experiment framing" data-xt="hyatt_proposal_planner|get_canvas|hyatt_proposal_builder" data-xd="CMS: expEyebrow, expHeadingHtml, expLede, controlTag/Title/Items, challengerTag/Title/Items, expResults[], expFootnote|The planner’s hypothesis, written to the canvas and read back by the builder|Illustrative uplift figures — flagged as such in expFootnote and the footer disclaimer">
    <div class="wrap">
      <div class="sec-head center reveal">
        {c.expEyebrow && <div class="eyebrow center">{c.expEyebrow}</div>}
        <h2 class="h-lg" set:html={richHtml(c.expHeadingHtml)} />
        {c.expLede && <p set:html={richHtml(c.expLede)} />}
      </div>
      <div class="ab-wrap">
        <div class="ab-card bad reveal">
          {c.controlTag && <span class="tag a">{c.controlTag}</span>}
          <h3>{c.controlTitle}</h3>
          <ul>{controlItems.map((x) => <li set:html={richHtml(x)} />)}</ul>
        </div>
        <div class="ab-vs">vs.</div>
        <div class="ab-card good winner reveal" data-delay="1">
          {c.challengerTag && <span class="tag b">{c.challengerTag}</span>}
          <h3>{c.challengerTitle}</h3>
          <ul>{challengerItems.map((x) => <li set:html={richHtml(x)} />)}</ul>
        </div>
      </div>
      {results.length > 0 && (
        <div class="ab-results reveal">
          {results.map((r) => (
            <div class="r"><div class="v">{r.value}</div><div class="k">{r.label}</div></div>
          ))}
        </div>
      )}
      {c.expFootnote && <p class="ab-footnote" set:html={richHtml(c.expFootnote)} />}
    </div>
  </section>
)}

{cities.length > 0 && (
  <section id="stay" data-xray="Where the team stays" data-xt="hyatt-vendor-facts|search_web|browse_web" data-xd="CMS: stayEyebrow, stayHeadingHtml, stayLede, stayCities[] ({city,pin,cards[{name,dist,body,image,alt}]})|Hotel names, brands and descriptions from hyatt-vendor-facts (group "hyatt")|Cities and walking distances anchored to the account’s venues via research (group "account")">
    <div class="wrap">
      <div class="sec-head reveal">
        {c.stayEyebrow && <div class="eyebrow">{c.stayEyebrow}</div>}
        <h2 class="h-lg" set:html={richHtml(c.stayHeadingHtml)} />
        {c.stayLede && <p set:html={richHtml(c.stayLede)} />}
      </div>
      {cities.map((city) => (
        <>
          <div class="city-label reveal">
            <h3>{city.city}</h3><div class="line"></div>
            {city.pin && <div class="pin">{city.pin}</div>}
          </div>
          <div class="stay-grid">
            {(city.cards ?? []).map((s, i) => (
              <div class="stay-card reveal" data-delay={i % 4 || undefined}>
                {s.image && <div class="ph"><img src={s.image} alt={s.alt ?? ''} loading="lazy" /></div>}
                <div class="body">
                  <h4>{s.name}</h4>
                  {s.dist && <span class="dist">{s.dist}</span>}
                  {s.body && <p set:html={richHtml(s.body)} />}
                </div>
              </div>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>
)}

{careItems.length > 0 && (
  <section id="care" data-xray="Service &amp; care band" data-xt="hyatt-vendor-facts|hyatt_proposal_builder" data-xd="CMS: careEyebrow, careHeadingHtml, careLede, careItems[] ({title,body}), careImage, careImageAlt|Hyatt Leverage and World of Hyatt programme mechanics from the vendor-facts skill (group "hyatt")">
    <div class="wrap">
      <div class="care-grid">
        <div class="reveal">
          {c.careEyebrow && <div class="eyebrow">{c.careEyebrow}</div>}
          <h2 class="h-lg" set:html={richHtml(c.careHeadingHtml)} />
          {c.careLede && <p class="lead" set:html={richHtml(c.careLede)} />}
          <ul class="care-list">
            {careItems.map((it) => (
              <li>
                <div class="dot" aria-hidden="true">✦</div>
                <div><b>{it.title}</b><span set:html={richHtml(it.body ?? '')} /></div>
              </li>
            ))}
          </ul>
        </div>
        {c.careImage && (
          <div class="care-img reveal" data-delay="1">
            <img src={c.careImage} alt={c.careImageAlt ?? ''} loading="lazy" />
          </div>
        )}
      </div>
    </div>
  </section>
)}

{c.quoteHtml && (
  <div class="strip" data-xray="Pull quote" data-xt="hyatt_proposal_builder|get_canvas" data-xd="CMS: quoteHtml, quoteCite|Written by the builder from the planner’s canvas — positioning line, not an attributed customer quote">
    <div class="wrap">
      <blockquote set:html={richHtml(c.quoteHtml)} />
      {c.quoteCite && <cite>{c.quoteCite}</cite>}
    </div>
  </div>
)}

<section id="contact" data-xray="Call to action &amp; lead form" data-xt="hyatt_proposal_planner|hyatt_proposal_builder|cms_update_content_item" data-xd="CMS: ctaEyebrow, ctaHeadingHtml, ctaBody, ctaKicker, signatureInitial/Name/Role, planOptions[], formButtonLabel, formNote, successHeading, successBody|Signature block is the Hyatt sales owner named in the request; plan options come from the account brief|The form is a demo — it posts nowhere and stays in the browser">
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-copy reveal">
        {c.ctaEyebrow && <div class="eyebrow">{c.ctaEyebrow}</div>}
        <h2 class="h-lg" set:html={richHtml(c.ctaHeadingHtml)} />
        {c.ctaBody && <p set:html={richHtml(c.ctaBody)} />}
        {c.ctaKicker && <p style="margin-top:14px">{c.ctaKicker}</p>}
        {c.signatureName && (
          <div class="sig">
            <div class="hy-avatar" aria-hidden="true">{c.signatureInitial ?? 'H'}</div>
            <div><b>{c.signatureName}</b><span>{c.signatureRole}</span></div>
          </div>
        )}
      </div>
      <form class="hy-card reveal" data-delay="1" id="leadform" novalidate>
        <div id="formfields">
          <div class="fld-row">
            <div class="fld"><label for="fname">Your name</label><input id="fname" name="name" type="text" autocomplete="name" required /></div>
            <div class="fld"><label for="femail">Work email</label><input id="femail" name="email" type="email" autocomplete="email" required /></div>
          </div>
          {planOptions.length > 0 && (
            <div class="fld">
              <label for="fplan">What are you planning?</label>
              <select id="fplan" name="plan">{planOptions.map((o) => <option>{o}</option>)}</select>
            </div>
          )}
          <div class="fld">
            <label for="fmsg">Anything we should know?</label>
            <textarea id="fmsg" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="hy-btn hy-btn-navy" style="width:100%;justify-content:center">{c.formButtonLabel ?? 'Send it up the trail →'}</button>
          {c.formNote && <p class="form-note">{c.formNote}</p>}
        </div>
        <div class="success" id="formsuccess" role="status">
          <div class="tick" aria-hidden="true">✓</div>
          <h3>{c.successHeading ?? 'Consider it packed.'}</h3>
          <p>{c.successBody}</p>
        </div>
      </form>
    </div>
  </div>
</section>

{sources.length > 0 && (
  <section id="sources" data-xray="Citations" data-xt="search_web|browse_web|hyatt-vendor-facts|cms_publish_content_item" data-xd="CMS: sourcesEyebrow, sourcesHeading, sourcesLede, sources[] ({n,label,url,group,publisher,date})|group "account" = research on the prospect; group "hyatt" = the vendor-facts skill|Inline [^n] markers elsewhere on the page resolve to these rows">
    <div class="wrap">
      <div class="sec-head reveal">
        {c.sourcesEyebrow && <div class="eyebrow">{c.sourcesEyebrow}</div>}
        <h2 class="h-lg">{c.sourcesHeading ?? 'Sources'}</h2>
        {c.sourcesLede && <p set:html={richHtml(c.sourcesLede)} />}
      </div>
      {[
        { key: 'account', label: 'On the account' },
        { key: 'hyatt',   label: 'Hyatt facts' },
      ].map((g) => {
        const items = sources.filter((s) => (s.group ?? 'account') === g.key);
        return items.length > 0 ? (
          <div class="src-group">
            <b>{g.label}</b>
            <ul class="src-list">
              {items.map((s) => (
                <li id={`source-${s.n}`}>
                  <span class="n">{s.n}</span>
                  <span>
                    {s.url ? <a href={s.url} target="_blank" rel="noopener">{s.label}</a> : s.label}
                    <span class="meta">
                      {[s.publisher || sourceDomain(s.url), s.date].filter(Boolean).join(' · ')}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ) : null;
      })}
    </div>
  </section>
)}

<footer data-xray="Footer &amp; disclaimer" data-xt="hyatt_proposal_builder|cms_publish_content_item" data-xd="CMS: wordmark, footerTagline, footerCols[] ({title,links[{label,url}]}), disclaimer|The disclaimer is emitted by the builder on every page: concept demonstration, figures illustrative, not an official Hyatt communication|Delivered to this page by Optimizely Graph from the published HyattProposal item">
  <div class="wrap">
    <div class="top">
      <div>
        <div class="fmark">{wordmark}<span>✦</span></div>
        {c.footerTagline && <p style="margin-top:12px;max-width:320px">{c.footerTagline}</p>}
      </div>
      <div class="cols">
        {footerCols.map((col) => (
          <div class="col">
            <b>{col.title}</b>
            {(col.links ?? []).map((l) => {
              const external = !!l.url && /^https?:/.test(l.url);
              return (
                <a href={l.url ?? '#'} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{l.label}</a>
              );
            })}
          </div>
        ))}
      </div>
    </div>
    {c.disclaimer && <p class="legal">{c.disclaimer}</p>}
  </div>
</footer>

<script is:inline>
  // sticky nav
  const nav = document.getElementById('nav');
  addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), { passive: true });

  // mobile menu
  const burger = document.getElementById('burger'), links = document.getElementById('navlinks');
  burger.addEventListener('click', () => {
    const open = burger.classList.toggle('open');
    links.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
  });
  links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    burger.classList.remove('open'); links.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');
  }));

  // reveal on scroll
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: .14 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // count-up stats
  const fmt = (n, p, s) => (p || '') + n.toLocaleString('en-US') + (s || '');
  const cio = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return; cio.unobserve(e.target);
    const el = e.target, target = +el.dataset.count, pre = el.dataset.prefix, suf = el.dataset.suffix;
    const t0 = performance.now(), dur = 1600;
    (function tick(t) {
      const k = Math.min((t - t0) / dur, 1), ease = 1 - Math.pow(1 - k, 3);
      el.textContent = fmt(Math.round(target * ease), pre, suf);
      if (k < 1) requestAnimationFrame(tick);
    })(t0);
  }), { threshold: .4 });
  document.querySelectorAll('.num[data-count]').forEach(el => cio.observe(el));

  // demo form — stays in the browser, posts nowhere
  document.getElementById('leadform').addEventListener('submit', e => {
    e.preventDefault();
    const n = document.getElementById('fname'), m = document.getElementById('femail');
    if (!n.value.trim()) { n.focus(); n.style.borderColor = '#b0524a'; return; }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(m.value.trim())) { m.focus(); m.style.borderColor = '#b0524a'; return; }
    document.getElementById('formfields').style.display = 'none';
    document.getElementById('formsuccess').classList.add('show');
  });
  document.querySelectorAll('#leadform input').forEach(i => i.addEventListener('input', () => i.style.borderColor = ''));

  // CMS preview: reload when the editor saves
  window.addEventListener('optimizely:cms:contentSaved', function (e) {
    var url = e.detail && e.detail.previewUrl;
    if (url) window.location.replace(url);
  });
</script>

<HyattXray />
</body>
</html>
