# ─── Optimizely Graph (content delivery) ─────────────────────────────
OPTIMIZELY_GRAPH_SINGLE_KEY=      # required — Graph single key
SITE_URL=http://localhost:4321    # must equal the CMS site's base URL exactly — the path query
                                  # filters on it, and a mismatch looks like missing content.
                                  # The dev server is pinned to this same port (strictPort), so
                                  # locally the two always agree. Confirm the base with:
                                  #   _Content { items { _metadata { url { base } } } }

# ─── Optimizely CMS ──────────────────────────────────────────────────
OPTIMIZELY_CMS_URL=               # required for preview — e.g. https://app-xxx.cms.optimizely.com
OPTIMIZELY_CMS_CLIENT_ID=         # required for `yarn cms:push` / `cms:pull` and seeding
OPTIMIZELY_CMS_CLIENT_SECRET=

# ─── Seeding ─────────────────────────────────────────────────────────
HYATT_CONTAINER_KEY=              # CMS content key the seeded proposal is created under
                                  # (must be under the site's content root — content under
                                  #  globalassets is invisible in the CMS tree)

# ─── Fallback site shell (Base.astro — only seen on errors/404) ───────
SITE_BRAND=Hyatt × Optimizely
SITE_LOGO_URL=
